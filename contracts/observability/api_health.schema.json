{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "service",
    "environment",
    "instance_id",
    "observed_at",
    "status",
    "request_id",
    "correlation_id",
    "build",
    "projection",
    "families"
  ],
  "properties": {
    "contract_version": { "type": "string" },
    "service": { "type": "string" },
    "environment": { "type": "string" },
    "instance_id": { "type": "string" },
    "observed_at": { "type": "string" },
    "status": { "type": "string" },
    "request_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "build": { "type": "object" },
    "projection": {
      "type": "object",
      "required": ["state", "stale", "observed_at", "last_synced_at"],
      "properties": {
        "state": { "type": "string" },
        "stale": { "type": "boolean" },
        "observed_at": { "type": ["string", "null"] },
        "last_synced_at": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "request_count", "error_count", "p95_ms"],
        "properties": {
          "family": { "type": "string" },
          "request_count": { "type": "integer" },
          "error_count": { "type": "integer" },
          "p95_ms": { "type": "number" },
          "observed_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
