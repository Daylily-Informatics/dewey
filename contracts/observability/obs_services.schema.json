{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "service",
    "environment",
    "instance_id",
    "observed_at",
    "status",
    "request_id",
    "correlation_id",
    "build",
    "projection",
    "endpoints",
    "extensions"
  ],
  "properties": {
    "contract_version": { "type": "string" },
    "service": { "type": "string" },
    "environment": { "type": "string" },
    "instance_id": { "type": "string" },
    "observed_at": { "type": "string" },
    "status": { "type": "string" },
    "request_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "build": { "type": "object" },
    "projection": {
      "type": "object",
      "required": ["state", "stale", "observed_at", "last_synced_at"],
      "properties": {
        "state": { "type": "string" },
        "stale": { "type": "boolean" },
        "observed_at": { "type": ["string", "null"] },
        "last_synced_at": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "auth", "kind"],
        "properties": {
          "path": { "type": "string" },
          "auth": { "type": "string" },
          "kind": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "extensions": { "type": "array" },
    "dependencies": {
      "type": "object",
      "properties": {
        "configured_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observed_services": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "managed_services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service_id", "base_url"],
        "properties": {
          "service_id": { "type": "string" },
          "display_name": { "type": "string" },
          "implementation": { "type": "string" },
          "parent_service": { "type": "string" },
          "base_url": { "type": "string" },
          "description": { "type": "string" },
          "plane": { "type": "string" },
          "auth_mode": { "type": "string" },
          "discovery_source": { "type": "string" },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "auth", "kind"],
              "properties": {
                "path": { "type": "string" },
                "auth": { "type": "string" },
                "kind": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
